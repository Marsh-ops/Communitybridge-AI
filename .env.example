# Copy to .env and fill in. .env is never committed.

# Local LLM used in development Set OLLAMA_MODEL to a model you have
# pulled with `ollama pull`, then run `python -m communitybridge.llm.check`.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Seconds to wait for a reply (a model loading for the first time can be slow). Default 120.
OLLAMA_TIMEOUT_SECONDS=120

# Optional capped hosted fallback provider: off by default
HOSTED_LLM_ENABLED=false

# Verifier: sources older than this many days are not shown as current. Default 180.
MAX_SOURCE_AGE_DAYS=180

# Web demo only: the date that "next month" is worked out from, as YYYY-MM-DD. Leave empty to use
# today's date. The synthetic data is built around November 2026, so set this when demonstrating
# in a different month. The page always shows the date in use.
COMMUNITYBRIDGE_TODAY=
